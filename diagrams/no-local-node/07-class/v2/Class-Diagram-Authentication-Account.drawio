  <diagram id="research-engines" name="Research Engines">
    <mxGraphModel dx="5592" dy="3300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4090" pageHeight="2150" background="#FFFFFF" math="0" shadow="0">
      <root>
