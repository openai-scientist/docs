<mxfile host="Electron" pages="8">
  <diagram id="authentication-account" name="Authentication &amp; Account">
    <mxGraphModel dx="2796" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2980" pageHeight="1392" background="#FFFFFF" math="0" shadow="0">
      <root>
