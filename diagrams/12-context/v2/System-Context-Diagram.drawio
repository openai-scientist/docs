        <mxCell id="flow-FE-08.1" data-fe="FE-08.1,FE-08.2,FE-08.3,FE-08.4" data-source-text="Develop an AnalysisPlan based on accepted research hypotheses and dataset information. | Recommend analytical methods, models, baselines, and evaluation metrics appropriate to the research objectives. | Define data processing procedures, hypothesis testing methods, and robustness assessments. | Identify methodological risks and validate analysis plans through preliminary testing before execution." data-wbs="7.1–7.3" edge="1" parent="1" source="platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.5576923076923077;entryPerimeter=0;exitX=0.03648759455652121;exitY=0.6875;exitPerimeter=0;" target="actor-1" value="Analysis plans, methods and validation results">
