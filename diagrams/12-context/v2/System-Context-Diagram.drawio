        <mxCell id="flow-FE-05.3" data-fe="FE-05.3,FE-05.4" data-source-text="Manage research questions, approval requests, and pending decisions through a centralized Decision Inbox. | Enable AI PI to recommend actions and make provisional decisions on permitted tasks during unattended Autopilot operation." data-wbs="5.1–5.2" edge="1" parent="1" source="platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.1423076923076923;entryPerimeter=0;exitX=0.0014082331205216292;exitY=0.5375;exitPerimeter=0;" target="actor-1" value="Pending decisions and automated research recommendations">
