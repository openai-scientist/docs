        <mxCell id="flow-FE-04.2" data-fe="FE-04.2,FE-04.3" data-source-text="Coordinate Research Runs across five stages: Dataset, Hypothesis, Experiment Design, Execution, and Paper. | Discover available project or public datasets and enforce one active Research Run per project." data-wbs="4.1–4.4" edge="1" parent="1" source="actor-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.33258928571428575;exitY=0;exitPerimeter=0;entryX=0.1298252831598918;entryY=0.1638888888888889;entryPerimeter=0;" target="platform" value="Run control and dataset selection requests">
