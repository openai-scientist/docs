        <mxCell id="flow-FE-07.3" data-fe="FE-07.3,FE-07.4,FE-07.5" data-source-text="Generate testable hypotheses with defined variables, comparators, evaluation metrics, and falsification criteria. | Evaluate hypothesis testability and allow researchers to select primary and secondary hypotheses. | Generate a HypothesisSet linking selected hypotheses to their supporting scientific evidence." data-wbs="6.3–6.4" edge="1" parent="1" source="platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.45384615384615384;entryPerimeter=0;exitX=0.023030399291527223;exitY=0.65;exitPerimeter=0;" target="actor-1" value="Testable hypotheses, selection requests and evidence links">
