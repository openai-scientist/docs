        <mxCell id="flow-FE-19.1" data-fe="FE-19.1,FE-19.2,FE-19.3" data-source-text="Design comparative studies of Machine Learning methods using the same dataset. | Support hyperparameter optimization, ensemble learning, stacking, ablation studies, and budget-aware evaluations. | Enforce fair comparison conditions through consistent data partitions, repeated trials, and comparable tuning budgets." data-wbs="10.3" edge="1" parent="1" source="actor-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.6674107142857142;exitY=0;exitPerimeter=0;entryX=0.03935766800619452;entryY=0.3055555555555556;entryPerimeter=0;" target="platform" value="Machine learning comparison requests and evaluation settings">
