        <mxCell id="flow-FE-06.1" data-fe="FE-06.1,FE-06.2,FE-06.3,FE-06.4,FE-06.5" data-source-text="Analyze dataset structure, characteristics, and overall data quality. | Detects missing values, duplicates, class imbalance, dataset shifts, and potential data leakage. | Recommend data cleaning and partitioning strategies based on dataset structure, sample size, and research objectives. | Assess dataset suitability for research questions and suggest feasible research directions. | Generate a DatasetSnapshot containing data profiles, preparation strategies, and identified limitations." data-wbs="6.1–6.2" edge="1" parent="1" source="platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.24615384615384617;entryPerimeter=0;exitX=0.005657001667870295;exitY=0.575;exitPerimeter=0;" target="actor-1" value="Dataset quality assessments and preparation recommendations">
