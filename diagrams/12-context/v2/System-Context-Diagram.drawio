nceBundle." data-wbs="8.1–8.5"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-10.1" parent="1" edge="1" source="platform" target="actor-1" value="Manuscript packages with tables, figures and references" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=0.890625;entryY=1;entryPerimeter=0;exitX=0.225;exitY=0.9175823272122516;exitPerimeter=0;" data-fe="FE-10.1,FE-10.2,FE-10.5" data-source-text="Generate scientific manuscripts following the IMRaD structure using verified research outputs. | Integrate validated statistics, tables, and figures from the EvidenceBundle. | Generate a PaperPack containing the manuscript, references, figures, tables, and supporting review information." data-wbs="9.3"><mxGeometry as="geometry" relative="1" x="-0.01656538730031132" y="0"><Array as="points"><mxPoint x="1550.0" y="1300" /><mxPoint x="335.0" y="1300" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-10.3" parent="1" edge="1" source="platform" target="actor-1" value="Citation, claim and reporting check results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=0.79296875;entryY=1;entryPerimeter=0;exitX=0.253125;exitY=0.9348019484489463;exitPerimeter=0;" data-fe="FE-10.3,FE-10.4" data-source-text="Manage citations and verify consistency between scientific claims, conclusions, and supporting evidence. | Check claim limitations, study limitations, and compliance with relevant reporting checklists." data-wbs="9.3"><mxGeometry as="geometry" relative="1" x="-0.02343265080780932" y="0"><Array as="points"><mxPoint x="1572.5" y="1328" /><mxPoint x="303.75" 