        <mxCell id="flow-FE-07.1" data-fe="FE-07.1,FE-07.2" data-source-text="Search, screen, and organize scientific literature from accessible academic sources within the Literature Base. | Synthesize scientific evidence, analyze related studies, and identify research gaps." data-wbs="6.3–6.4" edge="1" parent="1" source="platform" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.35;entryPerimeter=0;exitX=0.012820618252373113;exitY=0.6125;exitPerimeter=0;" target="actor-1" value="Literature collection, evidence synthesis and research gaps">
