ding approval decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=1;exitY=0.5232558139534884;exitPerimeter=0;entryX=0.3875;entryY=0.012820618252373185;entryPerimeter=0;" data-fe="FE-13.3" data-source-text="Require Project Manager approval for additional spending when project budget limits are reached." data-wbs="5.3"><mxGeometry as="geometry" relative="1" x="-0.18520960065216896" y="0"><Array as="points"><mxPoint x="1680.0" y="465.1162790697674" /></Array></mxGeometry></mxCell><mxCell id="flow-support-9" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-0" target="platform" value="Research dossier approval decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=1;exitY=0.6395348837209303;exitPerimeter=0;entryX=0.3625;entryY=0.01927788692426475;entryPerimeter=0;" data-fe="FE-14.2" data-source-text="Allow Reviewers or Project Managers to approve Dossiers according to project approval policies." data-wbs="10.1"><mxGeometry as="geometry" relative="1" x="-0.17314149077193597" y="0"><Array as="points"><mxPoint x="1660.0" y="490.69767441860466" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-02.4" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-0" value="Project activity records and archived workspaces" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.8255813953488372;entryPerimeter=0;exitX=0.3375;exitY=0.02714299201555657;exitPerimeter=0;" data-fe="FE-02.4" data-source-text="Maintain project activity logs and provide read-only access to archived projects." data-wbs="2.3–2.4"><mxGeometry as="geometry" relative="1" x="0.14894800923036478" y="0"><Array as="points"><mxPoint x="1640.0" y="531.6279069767442" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-13.2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-0" value="Resource usage, cost history and budget alerts" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.9418604651162791;entryPerimeter=0;exitX=0.3125;exitY=0.03648759455652103;exitPerimeter=0;" data-fe="FE-13.2,FE-13.4" data-source-text="Monitor resource consumption, track costs, and issue budget threshold alerts. | Maintain cost histories and enforce AI resource usage limits." data-wbs="5.3"><mxGeometry as="geometry" relative="1" x="0.13586807191627148" y="0"><Array as="points"><mxPoint x="1620.0" y="557.2093023255813" /></Array></mxGeometry></mxCell><mxCell id="actor-1" value="Researcher" parent="TSdrzwcUvg4kao8vxUGY-1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#111827;strokeColor=#111827;fillColor=#FFFFFF;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;"><mxGeometry as="geometry" x="50" y="990" width="320" height="260" /></mxCell><mxCell id="flow-FE-03.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Dataset, source and version management requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.109375;exitY=0;exitPerimeter=0;entryX=0.24615384615384614;entryY=0.06923076923076923;entryPerimeter=0;" data-fe="FE-03.1,FE-03.2,FE-03.3,FE-03.4" data-source-text="Upload and import tabular datasets from files and authorized external data sources. | Manage dataset versions and associate specific versions with research analyses. | Manage data connections and storage locations, including platform-hosted and local datasets. | Control dataset access and protect data connection credentials." data-wbs="3.1–3.2"><mxGeometry as="geometry" relative="1" x="0.15411635565312842" y="0"><Array as="points"><mxPoint x="85.0" y="720" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-04.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Research cases and research objectives" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.22098214285714288;exitY=0;exitPerimeter=0;entryX=0.18425536496052217;entryY=0.1123076923076923;entryPerimeter=0;" data-fe="FE-04.1" data-source-text="Create Research Cases with objectives, context, constraints, and references, with optional initial datasets." data-wbs="4.1–4.4"><mxGeometry as="geometry" relative="1" x="0.1476789381007979" y="0"><Array as="points"><mxPoint x="120.71428571428572" y="748" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-04.2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Run control and dataset selection requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.33258928571428575;exitY=0;exitPerimeter=0;entryX=0.1377290562487926;entryY=0.15538461538461537;entryPerimeter=0;" data-fe="FE-04.2,FE-04.3" data-source-text="Coordinate Research Runs across five stages: Dataset, Hypothesis, Experiment Design, Execution, and Paper. | Discover available project or public datasets and enforce one active Research Run per project." data-wbs="4.1–4.4"><mxGeometry as="geometry" relative="1" x="0.139163940567399" y="0"><Array as="points"><mxPoint x="156.42857142857144" y="776" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-05.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Research automation settings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.44419642857142855;exitY=0;exitPerimeter=0;entryX=0.10115848233537945;entryY=0.19846153846153847;entryPerimeter=0;" data-fe="FE-05.1" data-source-text="Configure AI autonomy using Co-work, Milestones, and Autopilot modes." data-wbs="5.1–5.2"><mxGeometry as="geometry" relative="1" x="0.12873897355993202" y="0"><Array as="points"><mxPoint x="192.14285714285714" y="804" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-05.2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Research approvals and automated decision overrides" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.5558035714285714;exitY=0;exitPerimeter=0;entryX=0.07198407373545707;entryY=0.24153846153846154;entryPerimeter=0;" data-fe="FE-05.2,FE-05.5" data-source-text="Require Researcher approval for critical decisions, including hypothesis selection, data structure confirmation, and analysis plan locking. | Allow Researchers to confirm or override AI decisions and review decision histories through the Decision Log." data-wbs="5.1–5.2"><mxGeometry as="geometry" relative="1" x="0.11637069703529312" y="0"><Array as="points"><mxPoint x="227.85714285714286" y="832" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-19.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Machine learning comparison requests and evaluation settings" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.6674107142857142;exitY=0;exitPerimeter=0;entryX=0.04876894227500088;entryY=0.2846153846153846;entryPerimeter=0;" data-fe="FE-19.1,FE-19.2,FE-19.3" data-source-text="Design comparative studies of Machine Learning methods using the same dataset. | Support hyperparameter optimization, ensemble learning, stacking, ablation studies, and budget-aware evaluations. | Enforce fair comparison conditions through consistent data partitions, repeated trials, and comparable tuning budgets." data-wbs="10.3"><mxGeometry as="geometry" relative="1" x="0.10192531228664303" y="0"><Array as="points"><mxPoint x="263.57142857142856" y="860" /></Array></mxGeometry></mxCell><mxCell id="flow-support-1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Hypothesis selections, plan locking and methodological change decisions" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.7790178571428571;exitY=0;exitPerimeter=0;entryX=0.030628016205059793;entryY=0.32769230769230767;entryPerimeter=0;" data-fe="support-1" data-source-text="Hypothesis selections, plan locking and methodological change decisions" data-wbs=""><mxGeometry as="geometry" relative="1" x="0.08519760884775729" y="0"><Array as="points"><mxPoint x="299.2857142857143" y="888" /></Array></mxGeometry></mxCell><mxCell id="flow-support-2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-1" target="platform" value="Journal profile approvals and research dossier export requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=0.890625;exitY=0;exitPerimeter=0;entryX=0.016989225499033297;entryY=0.3707692307692308;entryPerimeter=0;" data-fe="support-2" data-source-text="Journal profile approvals and research dossier export requests" data-wbs=""><mxGeometry as="geometry" relative="1" x="0.06591890984739557" y="0"><Array as="points"><mxPoint x="335.0" y="916" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-04.4" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Run progress, artifacts and completion recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.038461538461538464;entryPerimeter=0;exitX=0.0;exitY=0.5;exitPerimeter=0;" data-fe="FE-04.4,FE-04.5" data-source-text="Track research progress, stage outcomes, artifact versions, and changes affecting subsequent stages. | Support run cancellation, completion tracking, and recommendations for subsequent research activities." data-wbs="4.1–4.4"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-05.3" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Pending decisions and automated research recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.13076923076923078;entryPerimeter=0;exitX=0.0013651773185785032;exitY=0.536923076923077;exitPerimeter=0;" data-fe="FE-05.3,FE-05.4" data-source-text="Manage research questions, approval requests, and pending decisions through a centralized Decision Inbox. | Enable AI PI to recommend actions and make provisional decisions on permitted tasks during unattended Autopilot operation." data-wbs="5.1–5.2"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-06.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Dataset quality assessments and preparation recommendations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.2230769230769231;entryPerimeter=0;exitX=0.005483321249798223;exitY=0.5738461538461539;exitPerimeter=0;" data-fe="FE-06.1,FE-06.2,FE-06.3,FE-06.4,FE-06.5" data-source-text="Analyze dataset structure, characteristics, and overall data quality. | Detects missing values, duplicates, class imbalance, dataset shifts, and potential data leakage. | Recommend data cleaning and partitioning strategies based on dataset structure, sample size, and research objectives. | Assess dataset suitability for research questions and suggest feasible research directions. | Generate a DatasetSnapshot containing data profiles, preparation strategies, and identified limitations." data-wbs="6.1–6.2"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-07.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Literature collection, evidence synthesis and research gaps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.3153846153846154;entryPerimeter=0;exitX=0.012424182803542863;exitY=0.6107692307692307;exitPerimeter=0;" data-fe="FE-07.1,FE-07.2" data-source-text="Search, screen, and organize scientific literature from accessible academic sources within the Literature Base. | Synthesize scientific evidence, analyze related studies, and identify research gaps." data-wbs="6.3–6.4"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-07.3" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Testable hypotheses, selection requests and evidence links" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.4076923076923077;entryPerimeter=0;exitX=0.0223107890599573;exitY=0.6476923076923077;exitPerimeter=0;" data-fe="FE-07.3,FE-07.4,FE-07.5" data-source-text="Generate testable hypotheses with defined variables, comparators, evaluation metrics, and falsification criteria. | Evaluate hypothesis testability and allow researchers to select primary and secondary hypotheses. | Generate a HypothesisSet linking selected hypotheses to their supporting scientific evidence." data-wbs="6.3–6.4"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-08.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Analysis plans, methods and validation results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.5;entryPerimeter=0;exitX=0.03533112890649363;exitY=0.6846153846153846;exitPerimeter=0;" data-fe="FE-08.1,FE-08.2,FE-08.3,FE-08.4" data-source-text="Develop an AnalysisPlan based on accepted research hypotheses and dataset information. | Recommend analytical methods, models, baselines, and evaluation metrics appropriate to the research objectives. | Define data processing procedures, hypothesis testing methods, and robustness assessments. | Identify methodological risks and validate analysis plans through preliminary testing before execution." data-wbs="7.1–7.3"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-08.5" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Plan review, locking and change approval requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.5923076923076923;entryPerimeter=0;exitX=0.05175820134756322;exitY=0.7215384615384616;exitPerimeter=0;" data-fe="FE-08.5" data-source-text="Allow Researchers to review and lock analysis plans while tracking subsequent methodological changes." data-wbs="7.1–7.3"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-09.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Execution records, additional analyses and deviations" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.6846153846153846;entryPerimeter=0;exitX=0.07198407373545707;exitY=0.7584615384615384;exitPerimeter=0;" data-fe="FE-09.1,FE-09.4" data-source-text="Execute experiments according to locked AnalysisPlans within a controlled environment. | Track additional analyses, methodological deviations, and experimental exploration history." data-wbs="8.1–8.5"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-09.2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Confirmatory results and disclosure status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.7769230769230769;entryPerimeter=0;exitX=0.0965797117222749;exitY=0.7953846153846154;exitPerimeter=0;" data-fe="FE-09.2" data-source-text="Enforce analysis procedures and separate exploratory findings from confirmatory results until authorized disclosure." data-wbs="8.1–8.5"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-09.3" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Research evidence packages, verdicts and reproducibility results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=1;entryY=0.8692307692307693;entryPerimeter=0;exitX=0.12640717668411242;exitY=0.8323076923076923;exitPerimeter=0;" data-fe="FE-09.3,FE-09.5" data-source-text="Evaluate hypotheses through statistical verdicts, evidence grades, and permitted claim levels. | Verify result reproducibility and compile findings, tables, figures, and supporting records into an EvidenceBundle." data-wbs="8.1–8.5"><mxGeometry as="geometry" relative="1" x="0.0" y="0"><Array as="points" /></mxGeometry></mxCell><mxCell id="flow-FE-10.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value=