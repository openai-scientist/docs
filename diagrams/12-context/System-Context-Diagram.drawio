l profiles" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=0.6953125;entryY=1;entryPerimeter=0;exitX=0.28125;exitY=0.9496092053105675;exitPerimeter=0;" data-fe="FE-18.1,FE-18.2" data-source-text="Analyze authorized sample articles to identify journal structures, writing styles, and presentation characteristics. | Generate versioned Journal Profiles with source references, distinguishing observed conventions from publisher requirements." data-wbs="10.2"><mxGeometry as="geometry" relative="1" x="-0.028310182437700337" y="0"><Array as="points"><mxPoint x="1595.0" y="1356" /><mxPoint x="272.5" y="1356" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-18.3" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Journal profile approval requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;entryX=0.59765625;entryY=1;entryPerimeter=0;exitX=0.309375;exitY=0.9622359888357893;exitPerimeter=0;" data-fe="FE-18.3" data-source-text="Allow Researchers to approve and apply Journal Profiles during manuscript preparation without altering scientific claims." data-wbs="10.2"><mxGeometry as="geometry" relative="1" x="-0.03165610499705118" y="0"><Array as="points"><mxPoint x="1617.5" y="1384" /><mxPoint x="241.25" y="1384" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-19.4" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="platform" target="actor-1" value="Machine learning performance, stability and comparison results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;