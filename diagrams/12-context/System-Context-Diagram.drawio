      <mxCell id="platform" value="&lt;b&gt;OpenAI-Scientist&lt;/b&gt;&lt;br&gt;Tabular-data scientific research platform" parent="TSdrzwcUvg4kao8vxUGY-1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#111827;strokeColor=#111827;fillColor=#FFFFFF;ellipse;fontSize=28;align=center;verticalAlign=middle;strokeWidth=2.4;"><mxGeometry as="geometry" x="1370" y="675" width="800" height="650" /></mxCell><mxCell id="actor-0" value="Project Manager" parent="TSdrzwcUvg4kao8vxUGY-1" vertex="1" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontColor=#111827;strokeColor=#111827;fillColor=#FFFFFF;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1.5;"><mxGeometry as="geometry" x="400" y="350" width="320" height="220" /></mxCell><mxCell id="flow-FE-02.1" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-0" target="platform" value="Project management requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=1;exitY=0.05813953488372093;exitPerimeter=0;entryX=0.4875;entryY=0.0001562744216948886;entryPerimeter=0;" data-fe="FE-02.1" data-source-text="Create, manage, and archive research project workspaces." data-wbs="2.3–2.4"><mxGeometry as="geometry" relative="1" x="-0.2309460680654245" y="0"><Array as="points"><mxPoint x="1760.0" y="362.7906976744186" /></Array></mxGeometry></mxCell><mxCell id="flow-FE-02.2" parent="TSdrzwcUvg4kao8vxUGY-1" edge="1" source="actor-0" target="platform" value="Member and invitation management requests" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#111827;strokeWidth=1.4;endArrow=classic;endFill=1;endSize=9;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;labelBackgroundColor=#FFFFFF;spacing=2;exitX=1;exitY=0.1744186046511628;exitPerimeter=0;entryX=0.4625;entryY=0.0014082331205218697;entryPer