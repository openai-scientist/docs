  <diagram id="project-workspace" name="Project Workspace">
    <mxGraphModel dx="2357" dy="1402" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2900" pageHeight="2500" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;base\&quot;, \&quot;themeVariables\&quot;: {\&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;lineColor\&quot;: \&quot;#000000\&quot;, \&quot;textColor\&quot;: \&quot;#000000\&quot;, \&quot;background\&quot;: \&quot;#ffffff\&quot;}}}%%\nclassDiagram\n    direction TB\n    class ProjectController {\n        &lt;&lt;controller&gt;&gt;\n        + create(input : ProjectInput) : Project\n        + update(projectId : UUID, input : ProjectInput) : void\n        + archive(projectId : UUID) : void\n        + manageMembers(projectId : UUID) : void\n        + manageInvitations(projectId : UUID) : void\n        + manageDocuments(projectId : UUID) : void\n        + configure(projectId : UUID, settings : ProjectSettings) : void\n    }\n    class ProjectService {\n        &lt;&lt;service&gt;&gt;\n        + create(input : ProjectInput) : Project\n        + update(projectId : UUID, input : ProjectInput) : void\n        + archive(projectId : UUID) : void\n        + configure(settings : ProjectSettings) : void\n        + recordChange(action : String) : void\n    }\n    class Project {\n        &lt;&lt;entity&gt;&gt;\n        - id : UUID\n        - name : String\n        - status : String\n    }\n    class ProjectSettings {\n        &lt;&lt;entity&gt;&gt;\n        - monthlyBudget : Decimal\n        - defaultPresetPerStage : Map\n        - reviewSettings : ReviewSettings\n        - notificationChoices : Map\n        - pinnedWaitDeadline : Duration\n    }\n    class MembershipService {\n        &lt;&lt;service&gt;&gt;\n        + changeRole(memberId : UUID, role : ProjectRole) : void\n        + remove(memberId : UUID) : void\n        + transferOwnership(projectId : UUID, userId : UUID) : void\n        - requireActiveManager(projectId : UUID) : void\n    }\n    class Membership {\n        &lt;&lt;entity&gt;&gt;\n        - projectId : UUID\n        - role : ProjectRole\n        - dateAdded : DateTime\n    }\n    class User {\n        &lt;&lt;entity&gt;&gt;\n        - id : UUID\n        - email : String\n    }\n    class InvitationService {\n        &lt;&lt;service&gt;&gt;\n        + invite(projectId : UUID, email : String) : Invitation\n        + accept(invitationId : UUID) : Membership\n        + decline(invitationId : UUID) : void\n        + resend(invitationId : UUID) : void\n        + cancel(invitationId : UUID) : void\n        - rejectExpired(invitation : Invitation) : void\n    }\n    class Invitation {\n        &lt;&lt;entity&gt;&gt;\n        - id : UUID\n        - projectId : UUID\n        - email : String\n        - role : ProjectRole\n        - expiresAt : DateTime\n        - status : String\n    }\n    class DocumentService {\n        &lt;&lt;service&gt;&gt;\n        + add(projectId : UUID, input : DocumentInput) : Document\n        + update(documentId : UUID, input : DocumentInput) : void\n        + list(projectId : UUID) : Document [0..*]\n    }\n    class Document {\n        &lt;&lt;entity&gt;&gt;\n        - id : UUID\n        - projectId : UUID\n        - name : String\n        - version : Integer\n    }\n    class AuditLogEntry {\n        &lt;&lt;entity&gt;&gt;\n        - action : String\n        - actorId : UUID\n        - projectId : UUID [0..1]\n        - time : DateTime\n    }\n    ProjectController ..&gt; ProjectService : uses\n    ProjectController ..&gt; MembershipService : manages members\n    ProjectController ..&gt; InvitationService : manages invitations\n    ProjectController ..&gt; DocumentService : manages documents\n    ProjectService ..&gt; Project : manages\n    MembershipService ..&gt; Membership : maintains\n    InvitationService ..&gt; Invitation : issues / resolves\n    DocumentService ..&gt; Document : versions\n    Project \&quot;1\&quot; *-- \&quot;1\&quot; ProjectSettings : settings\n    Membership \&quot;0..*\&quot; -- \&quot;1\&quot; User : member\n    Project \&quot;1\&quot; -- \&quot;0..*\&quot; Membership : memberships\n    ProjectController ..&gt; AuditLogEntry : reads project activity&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s2OfNu6BL8vqZqkLtZwW-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;ProjectController&lt;/b&gt;" mermaidId="n:ProjectController" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=72;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#ffffff;whiteSpace=wrap;spacingTop=24;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;ProjectController&lt;/b&gt;" id="s2OfNu6BL8vqZqkLtZwW-2">
