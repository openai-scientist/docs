  <diagram id="ai-principal-investigator" name="AI Principal Investigator">
    <mxGraphModel dx="7674" dy="2357" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3680" pageHeight="1774" background="#FFFFFF" math="0" shadow="0">
      <root>
